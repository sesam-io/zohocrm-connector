{
  "_id": "{{@ system @}}",
  "oauth2": {
    "access_token": "$SECRET(oauth_access_token)",
    "client_id": "$SECRET(oauth_client_id)",
    "client_secret": "$SECRET(oauth_client_secret)",
    "refresh_token": "$SECRET(oauth_refresh_token)",
    "token_url": "{{@ token_url @}}"
  },
  "operations": {
    "account-delete": {
      "method": "DELETE",
      "url": "Accounts/{{ entity['$source']['id'] }}"
    },
    "account-insert": {
      "id_expression": "{{ id }}",
      "method": "POST",
      "payload-type": "json",
      "payload_property": "data",
      "url": "Accounts"
    },
    "account-lookup": {
      "method": "GET",
      "payload_property": "data",
      "url": "Accounts/{{ entity['$source']['id'] }}"
    },
    "account-update": {
      "method": "PUT",
      "payload-type": "json",
      "payload_property": "data",
      "url": "Accounts"
    },
    "contact-delete": {
      "method": "DELETE",
      "url": "Contacts/{{ entity['$source']['id'] }}"
    },
    "contact-insert": {
      "id_expression": "{{ id }}",
      "method": "POST",
      "payload-type": "json",
      "payload_property": "data",
      "url": "Contacts"
    },
    "contact-lookup": {
      "method": "GET",
      "payload_property": "data",
      "url": "Contacts/{{ entity['$source']['id'] }}"
    },
    "contact-update": {
      "method": "PUT",
      "payload-type": "json",
      "payload_property": "data",
      "url": "Contacts"
    },
    "deal-delete": {
      "method": "DELETE",
      "url": "Deals/{{ entity['$source']['id'] }}"
    },
    "deal-insert": {
      "id_expression": "{{ id }}",
      "method": "POST",
      "payload-type": "json",
      "payload_property": "data",
      "url": "Deals"
    },
    "deal-lookup": {
      "method": "GET",
      "payload_property": "data",
      "url": "Deals/{{ entity['$source']['id'] }}"
    },
    "deal-update": {
      "method": "PUT",
      "payload-type": "json",
      "payload_property": "data",
      "url": "Deals"
    },
    "list-records": {
      "method": "GET",
      "next_page_link": "{% if body.info is defined and body.info.next_page_token is defined and body.info.next_page_token %}{{ properties.module }}?fields={{ properties.fields }}&sort_order=asc&sort_on=Modified_Time&per_page=10&page_token={{ body.info.next_page_token }}{% else %}{% endif %}",
      "since_property_location": "header",
      "since_property_name": "If-Modified-Since",
      "updated_expression": "{{ entity.Modified_Time }}",
      "url": "{{ properties.module }}?fields={{ properties.fields }}&per_page=10&sort_order=asc&sort_on=Modified_Time"
    },
    "product-delete": {
      "method": "DELETE",
      "url": "Products/{{ entity['$source']['id'] }}"
    },
    "product-insert": {
      "id_expression": "{{ id }}",
      "method": "POST",
      "payload-type": "json",
      "payload_property": "data",
      "url": "Products"
    },
    "product-lookup": {
      "method": "GET",
      "payload_property": "data",
      "url": "Products/{{ entity['$source']['id'] }}"
    },
    "product-update": {
      "method": "PUT",
      "payload-type": "json",
      "payload_property": "data",
      "url": "Products"
    },
    "purchaseorder-delete": {
      "method": "DELETE",
      "url": "Purchase_Orders/{{ entity['$source']['id'] }}"
    },
    "purchaseorder-insert": {
      "id_expression": "{{ id }}",
      "method": "POST",
      "payload-type": "json",
      "payload_property": "data",
      "url": "Purchase_Orders"
    },
    "purchaseorder-lookup": {
      "method": "GET",
      "payload_property": "data",
      "url": "Purchase_Orders/{{ entity.id }}"
    },
    "purchaseorder-update": {
      "method": "PUT",
      "payload-type": "json",
      "payload_property": "data",
      "url": "Purchase_Orders"
    },
    "quote-delete": {
      "method": "DELETE",
      "url": "Quotes/{{ entity['$source']['id'] }}"
    },
    "quote-insert": {
      "id_expression": "{{ id }}",
      "method": "POST",
      "payload-type": "json",
      "payload_property": "data",
      "url": "Quotes"
    },
    "quote-lookup": {
      "method": "GET",
      "payload_property": "data",
      "url": "Quotes/{{ entity.id }}"
    },
    "quote-update": {
      "method": "PUT",
      "payload-type": "json",
      "payload_property": "data",
      "url": "Quotes"
    },
    "salesorder-delete": {
      "method": "DELETE",
      "url": "Sales_Orders/{{ entity['$source']['id'] }}"
    },
    "salesorder-insert": {
      "id_expression": "{{ id }}",
      "method": "POST",
      "payload-type": "json",
      "payload_property": "data",
      "url": "Sales_Orders"
    },
    "salesorder-lookup": {
      "method": "GET",
      "payload_property": "data",
      "url": "Sales_Orders/{{ entity.id }}"
    },
    "salesorder-update": {
      "method": "PUT",
      "payload-type": "json",
      "payload_property": "data",
      "url": "Sales_Orders"
    }
  },
  "type": "system:rest",
  "url_pattern": "https://www.zohoapis.eu/crm/v3/%s",
  "verify_ssl": true
}